# Google *web* OAuth client ID — the one that already backs desktop sign-in.
#
# Used on Android as the audience of the ID token handed to
# supabase.auth.signInWithIdToken. Supabase's Google provider already trusts this
# client, so no new Authorized Client ID is needed.
#
# The Android OAuth client still has to exist in Google Cloud — Google keys the
# native sign-in on (package name, signing SHA-1) — but it is not the audience,
# so its ID does not appear here.
#
# applicationId: com.aswinmanohar.cashflow
VITE_GOOGLE_WEB_CLIENT_ID=
