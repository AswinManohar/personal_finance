# Google *web* OAuth client ID — the one that already backs desktop sign-in.
#
# Used on Android as the audience of the ID token handed to
# supabase.auth.signInWithIdToken. Supabase's Google provider already trusts this
# client, so no new Authorized Client ID is needed.
#
# The Android OAuth client still has to exist in Google Cloud — Google keys the
# native sign-in on (package name, signing SHA-1) — but it is not the audience,
# so its ID does not appear here.
#
# applicationId: com.aswinmanohar.cashflow
VITE_GOOGLE_WEB_CLIENT_ID=

# Backend origin used by the ANDROID build for /api/* calls (statement review,
# one-click import). The web build keeps relative URLs and ignores this.
# Defaults to the Railway production host when unset.
#VITE_API_BASE_URL=https://web-production-5ebee.up.railway.app

# Android-type OAuth client ID for Gmail access (Sparkasse capture).
# Distinct from VITE_GOOGLE_WEB_CLIENT_ID, which is for Supabase sign-in.
# The consent screen must be published "In production" — while it is in
# Testing, Google expires the refresh token every 7 days.
VITE_GOOGLE_ANDROID_CLIENT_ID=

# --- Backend (api/) -------------------------------------------------------

# OpenAI key for the statement-review pipeline and the merchant-guess agent.
#OPENAI_API_KEY=
# Model both use. Defaults to gpt-5.1.
#OPENAI_MODEL=gpt-5.1

# Logfire token for tracing the API and every LLM call it makes. Optional:
# without it, instrumentation is configured but exports nothing, so dev and CI
# behave exactly as before. Set it to see merchant guesses, token usage and
# latency in Logfire, and to compare eval runs across prompt changes.
#LOGFIRE_TOKEN=
